# ============================================================
# JANJATHI SHIKSHA SETU — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SQLite (default for local dev — zero config):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/janjathi_db"

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Demo / OTP ───────────────────────────────────────────────
DEMO_OTP=123456
DEMO_STUDENT_MOBILE=9999999999
DEMO_ADMIN_EMAIL=admin@janjathi.gov.in
DEMO_ADMIN_PASSWORD=Admin@Demo2024

# ── AI Provider ──────────────────────────────────────────────
# Options: mock | gemini | openrouter
AI_PROVIDER=mock

# Google Gemini (free tier available at ai.google.dev):
GEMINI_API_KEY=

# OpenRouter (free models available at openrouter.ai):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ── Storage ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
